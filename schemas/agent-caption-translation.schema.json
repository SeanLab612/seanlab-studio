{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "en"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "en": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
