{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remotion-md.local/schemas/visual-direction-plan.schema.json",
  "type": "object",
  "required": ["schemaVersion", "policy", "durationSeconds", "chapters", "decisions"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "policy": {"$ref": "#/$defs/policy"},
    "durationSeconds": {"type": "number", "minimum": 0},
    "chapters": {"type": "array", "items": {"$ref": "#/$defs/chapter"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "maximumVisualsPerMinute",
        "minimumBreathingGapSeconds",
        "minimumVisibleSeconds",
        "maximumAccentSeconds",
        "maximumSupportSeconds",
        "maximumHeroSeconds",
        "maximumContinuousVisualSeconds",
        "repetitionWindowSeconds",
        "minimumHeroGapSeconds",
        "maximumVisualCoverageRatio",
        "maximumChapterSeconds",
        "maximumChapterCandidates",
        "heroConfidence",
        "supportConfidence",
        "accentConfidence"
      ],
      "properties": {
        "version": {"const": "1.0"},
        "maximumVisualsPerMinute": {"type": "integer", "minimum": 1},
        "minimumBreathingGapSeconds": {"type": "number", "exclusiveMinimum": 0},
        "minimumVisibleSeconds": {"type": "number", "exclusiveMinimum": 0},
        "maximumAccentSeconds": {"type": "number", "exclusiveMinimum": 0},
        "maximumSupportSeconds": {"type": "number", "exclusiveMinimum": 0},
        "maximumHeroSeconds": {"type": "number", "exclusiveMinimum": 0},
        "maximumContinuousVisualSeconds": {"type": "number", "exclusiveMinimum": 0},
        "repetitionWindowSeconds": {"type": "number", "exclusiveMinimum": 0},
        "minimumHeroGapSeconds": {"type": "number", "exclusiveMinimum": 0},
        "maximumVisualCoverageRatio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "minimumVisualCoverageRatio": {"type": "number", "minimum": 0, "maximum": 1},
        "maximumAnimationCoverageRatio": {"type": "number", "minimum": 0, "maximum": 1},
        "maximumChapterSeconds": {"type": "number", "exclusiveMinimum": 0},
        "maximumChapterCandidates": {"type": "integer", "minimum": 1},
        "heroConfidence": {"type": "number", "minimum": 0, "maximum": 1},
        "supportConfidence": {"type": "number", "minimum": 0, "maximum": 1},
        "accentConfidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "startCue", "endCue", "candidateIds"],
      "properties": {
        "id": {"type": "string", "pattern": "^chapter-[1-9][0-9]*$"},
        "label": {"type": "string", "minLength": 1},
        "startCue": {"type": "integer", "minimum": 0},
        "endCue": {"type": "integer", "minimum": 0},
        "candidateIds": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "semanticIndex",
        "startCue",
        "endCue",
        "sourceStart",
        "sourceEnd",
        "displayStart",
        "displayEnd",
        "action",
        "importance",
        "rhetoric",
        "componentId",
        "chapterId",
        "boundaryActions",
        "adjustments",
        "reasons"
      ],
      "properties": {
        "candidateId": {"type": "string", "minLength": 1},
        "semanticIndex": {"type": "integer", "minimum": 0},
        "startCue": {"type": "integer", "minimum": 0},
        "endCue": {"type": "integer", "minimum": 0},
        "sourceStart": {"type": "number", "minimum": 0},
        "sourceEnd": {"type": "number", "minimum": 0},
        "displayStart": {"type": ["number", "null"], "minimum": 0},
        "displayEnd": {"type": ["number", "null"], "minimum": 0},
        "action": {"enum": ["show", "skip"]},
        "importance": {"enum": ["hero", "support", "accent", "none"]},
        "rhetoric": {"type": "string", "minLength": 1},
        "componentId": {"type": ["string", "null"]},
        "chapterId": {"type": "string", "pattern": "^chapter-[1-9][0-9]*$"},
        "boundaryActions": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["single-caption", "merge-captions", "split-adjacent-claim"]}
        },
        "adjustments": {
          "type": "array",
          "items": {"enum": ["delayed-for-breathing", "shortened-to-tier-budget"]}
        },
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
