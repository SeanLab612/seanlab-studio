{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-remotion.local/schemas/chart-qa-report.schema.json",
  "title": "16:9 Chart Foundation QA Report",
  "type": "object",
  "required": ["schemaVersion", "canvas", "recipes", "riskFrames", "status", "semanticModelChecks", "summary", "findings", "metrics"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {"width": {"const": 1920}, "height": {"const": 1080}},
      "additionalProperties": false
    },
    "recipes": {"const": 10},
    "riskFrames": {"const": 40},
    "status": {"enum": ["passed", "failed"]},
    "semanticModelChecks": {"const": "passed-during-remotion-render"},
    "summary": {
      "type": "object",
      "required": ["errors", "warnings"],
      "properties": {"errors": {"type": "integer", "minimum": 0}, "warnings": {"type": "integer", "minimum": 0}},
      "additionalProperties": false
    },
    "findings": {"type": "array", "items": {"type": "object"}},
    "metrics": {"type": "array", "minItems": 40, "items": {"type": "object"}}
  },
  "additionalProperties": false
}
