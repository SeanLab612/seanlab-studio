{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "rootCause",
    "evidence",
    "recommendedAction",
    "safeToResume",
    "userMessage",
    "technicalNotes"
  ],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "rootCause": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "evidence": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "recommendedAction": {
      "type": "string",
      "enum": [
        "recheck",
        "resume",
        "repair-config",
        "repair-code",
        "repair-binding",
        "repair-visual",
        "request-user"
      ]
    },
    "safeToResume": { "type": "boolean" },
    "userMessage": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "technicalNotes": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  }
}
