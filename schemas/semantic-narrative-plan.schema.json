{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remotion-md.local/schemas/semantic-narrative-plan.schema.json",
  "type": "object",
  "required": ["schemaVersion", "analyzedThroughCue", "videoIdentity", "visualDecisions", "materialAssignments", "segments"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0"},
    "analyzedThroughCue": {"type": "integer", "minimum": 0},
    "videoIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "subject", "startCue", "endCue", "confidence"],
      "properties": {
        "eyebrow": {"type": "string", "minLength": 1, "maxLength": 28},
        "title": {"type": "string", "minLength": 1, "maxLength": 32},
        "subject": {"type": "string", "minLength": 1, "maxLength": 48},
        "startCue": {"type": "integer", "minimum": 0},
        "endCue": {"type": "integer", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "visualDecisions": {
      "type": "array",
      "maxItems": 96,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["beatId", "action", "reason"],
        "properties": {
          "beatId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
          "action": {"enum": ["use", "skip"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "materialAssignments": {
      "type": "array",
      "maxItems": 96,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "kind", "startCue", "endCue", "order", "reason"],
        "properties": {
          "assetId": {"type": "string", "minLength": 1, "maxLength": 63},
          "kind": {"enum": ["image", "screen-demo"]},
          "startCue": {"type": "integer", "minimum": 0},
          "endCue": {"type": "integer", "minimum": 0},
          "order": {"type": "integer", "minimum": 1, "maximum": 96},
          "reason": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "segments": {
      "type": "array",
      "maxItems": 48,
      "items": {"$ref": "#/$defs/segment"}
    }
  },
  "$defs": {
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "subtitleZh", "subtitleEn", "takeaway"],
      "properties": {
        "eyebrow": {"type": "string", "minLength": 1, "maxLength": 28},
        "title": {"type": "string", "minLength": 1, "maxLength": 32},
        "subtitleZh": {"type": "string", "minLength": 1, "maxLength": 72},
        "subtitleEn": {"type": "string", "minLength": 1, "maxLength": 120},
        "takeaway": {"type": "string", "minLength": 1, "maxLength": 72}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label", "detail", "value", "displayValue", "unit", "timeLabel",
        "entityId", "entityKind", "x", "y", "xBand", "yBand", "direction", "startCue", "endCue"
      ],
      "properties": {
        "label": {"type": "string", "maxLength": 18},
        "detail": {"type": "string", "maxLength": 36},
        "value": {"type": ["number", "null"]},
        "displayValue": {"type": "string", "maxLength": 24},
        "unit": {"type": "string", "maxLength": 16},
        "timeLabel": {"type": "string", "maxLength": 20},
        "entityId": {"type": "string", "maxLength": 96},
        "entityKind": {
          "enum": [
            "none", "person", "brand", "biotech", "government", "country", "ticker",
            "exchange", "research", "university", "media", "ai", "design"
          ]
        },
        "x": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "y": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "xBand": {"enum": ["none", "low", "high"]},
        "yBand": {"enum": ["none", "low", "high"]},
        "direction": {"enum": ["none", "up", "down", "stable"]},
        "startCue": {"type": "integer", "minimum": 0},
        "endCue": {"type": "integer", "minimum": 0}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeLabel", "value"],
      "properties": {
        "timeLabel": {"type": "string", "maxLength": 20},
        "value": {"type": "number"}
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "valueLabel", "points"],
      "properties": {
        "name": {"type": "string", "maxLength": 28},
        "valueLabel": {"type": "string", "maxLength": 24},
        "points": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"$ref": "#/$defs/point"}}
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "columns", "values", "states", "xLabel", "yLabel"],
      "properties": {
        "rows": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 24}},
        "columns": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 24}},
        "values": {
          "type": "array",
          "maxItems": 6,
          "items": {"type": "array", "maxItems": 6, "items": {"type": "number", "minimum": 0, "maximum": 100}}
        },
        "states": {
          "type": "array",
          "maxItems": 6,
          "items": {"type": "array", "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 24}}
        },
        "xLabel": {"type": "string", "maxLength": 24},
        "yLabel": {"type": "string", "maxLength": 24}
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sourceName", "sourceRole"],
      "properties": {
        "text": {"type": "string", "maxLength": 160},
        "sourceName": {"type": "string", "maxLength": 40},
        "sourceRole": {"type": "string", "maxLength": 56}
      }
    },
    "mediaIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entityId"],
      "properties": {
        "kind": {
          "enum": [
            "person", "brand", "biotech", "government", "country", "ticker", "exchange",
            "research", "university", "media", "ai", "design"
          ]
        },
        "entityId": {"type": "string", "minLength": 1, "maxLength": 96}
      }
    },
    "imageEvidence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["assetId", "purpose", "caption"],
      "properties": {
        "assetId": {"type": "string", "minLength": 1, "maxLength": 63},
        "purpose": {"enum": ["show", "prove", "explain", "compare"]},
        "caption": {"type": "string", "maxLength": 56}
      }
    },
    "animationStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "spokenQuote", "action", "label"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
        "spokenQuote": {"type": "string", "minLength": 1, "maxLength": 120},
        "action": {"type": "string", "minLength": 1, "maxLength": 32},
        "label": {"type": "string", "minLength": 1, "maxLength": 24}
      }
    },
    "animationIntent": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["prototypeId", "styleProfileId", "stages", "takeaway"],
      "properties": {
        "prototypeId": {"enum": ["process-flow", "state-transition", "evidence-gate", "causal-chain", "before-after", "layered-system", "aggregate-decompose", "focus-zoom", "threshold-landing", "converge-diffuse"]},
        "styleProfileId": {"type": "string", "const": "paper-editorial"},
        "stages": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"$ref": "#/$defs/animationStage"}},
        "takeaway": {"type": "string", "minLength": 1, "maxLength": 72}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startCue", "endCue", "visualPriority", "rhetoric", "motionIntent", "reason", "confidence",
        "narrative", "items", "timeSeries", "matrix", "quote", "mediaIntents", "imageEvidence", "animationIntent"
      ],
      "properties": {
        "startCue": {"type": "integer", "minimum": 0},
        "endCue": {"type": "integer", "minimum": 0},
        "visualPriority": {"enum": ["skip", "normal", "high"]},
        "rhetoric": {
          "enum": [
            "none", "scenario", "comparison", "trend", "distribution", "person-evidence",
            "factor-sequence", "process-steps", "ranking", "key-stat", "media-comparison", "image-evidence",
            "causal-chain", "quote-source", "historical-timeline", "decision-matrix",
            "model-classification", "core-positioning", "capability-surface", "tradeoff", "editorial-statement"
          ]
        },
        "motionIntent": {"enum": ["introduce", "compare", "progress", "reorder", "transform", "emphasize"]},
        "reason": {"type": "string", "maxLength": 160},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "narrative": {"$ref": "#/$defs/narrative"},
        "items": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/item"}},
        "timeSeries": {"type": "array", "maxItems": 7, "items": {"$ref": "#/$defs/series"}},
        "matrix": {"$ref": "#/$defs/matrix"},
        "quote": {"$ref": "#/$defs/quote"},
        "mediaIntents": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/mediaIntent"}},
        "imageEvidence": {"$ref": "#/$defs/imageEvidence"},
        "animationIntent": {"$ref": "#/$defs/animationIntent"}
      }
    }
  }
}
