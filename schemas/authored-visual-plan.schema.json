{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seanlab.local/schemas/authored-visual-plan.schema.json",
  "title": "Locked Authored Visual Plan",
  "type": "object",
  "required": ["schemaVersion", "visualPlanContractVersion", "finalScriptSha256", "sections", "beats", "annotations"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "visualPlanContractVersion": {"const": "3.0"},
    "finalScriptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sectionId", "anchorText", "endAnchorText", "mode"],
        "properties": {
          "sectionId": {"type": "string", "minLength": 1},
          "anchorText": {"type": "string", "minLength": 1},
          "endAnchorText": {"type": "string", "minLength": 1},
          "mode": {"enum": ["auto", "speaker", "speaker-only", "material", "information", "animation"]},
          "form": {"type": "string", "minLength": 1},
          "componentId": {"type": "string", "minLength": 1},
          "episodeTag": {"type": "string", "minLength": 2, "maxLength": 24, "pattern": "^[^\\r\\n]+$"},
          "materialId": {"type": "string", "minLength": 1},
          "materialDisplay": {"enum": ["full", "crop", "annotate"]},
          "animationAnchorText": {"type": "string", "minLength": 1},
          "animationEndAnchorText": {"type": "string", "minLength": 1},
          "animationIntent": {"$ref": "#/$defs/animationIntent"}
        },
        "additionalProperties": false
      }
    },
    "annotations": {
      "type": "array",
      "items": {"$ref": "#/$defs/lockedTextAnnotation"}
    },
    "beats": {
      "type": "array",
      "items": {"$ref": "#/$defs/lockedVisualBeat"}
    }
  },
  "$defs": {
    "lockedVisualBeat": {
      "type": "object",
      "required": [
        "id",
        "sectionId",
        "exactSpokenQuote",
        "status",
        "primaryVisualType",
        "takeover",
        "speakerPresence",
        "quoteStart",
        "quoteEnd",
        "exactSpokenQuoteSha256",
        "finalScriptSha256"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
        "sectionId": {"type": "string", "minLength": 1},
        "exactSpokenQuote": {"type": "string", "minLength": 1, "maxLength": 240},
        "quoteOccurrence": {"type": "integer", "minimum": 1},
        "status": {"const": "confirmed"},
        "primaryVisualType": {"enum": ["speaker", "component", "image", "screen-demo", "animation"]},
        "semanticForm": {"type": "string", "minLength": 1},
        "materialId": {"type": "string", "minLength": 1},
        "materialIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "materialAssetId": {"type": "string", "minLength": 1},
        "materialAssetIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "materialDisplay": {"enum": ["full", "crop", "annotate"]},
        "animationIntent": {"$ref": "#/$defs/animationIntent"},
        "takeover": {"enum": ["none", "partial", "full"]},
        "speakerPresence": {"enum": ["full", "circle-pip", "hidden"]},
        "quoteStart": {"type": "integer", "minimum": 0},
        "quoteEnd": {"type": "integer", "minimum": 1},
        "exactSpokenQuoteSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "finalScriptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "lockedTextAnnotation": {
      "type": "object",
      "required": [
        "id",
        "sectionId",
        "exactSpokenQuote",
        "status",
        "effect",
        "quoteStart",
        "quoteEnd",
        "exactSpokenQuoteSha256",
        "finalScriptSha256"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
        "sectionId": {"type": "string", "minLength": 1},
        "exactSpokenQuote": {"type": "string", "minLength": 2, "maxLength": 24, "pattern": "^[^\\r\\n]+$"},
        "quoteOccurrence": {"type": "integer", "minimum": 1},
        "status": {"const": "confirmed"},
        "effect": {"enum": ["highlight", "underline", "circle", "box", "crossed-off", "strike-through", "bracket"]},
        "quoteStart": {"type": "integer", "minimum": 0},
        "quoteEnd": {"type": "integer", "minimum": 1},
        "exactSpokenQuoteSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "finalScriptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "animationIntent": {
      "type": "object",
      "required": ["prototypeId", "styleProfileId", "stages", "takeaway"],
      "properties": {
        "prototypeId": {"enum": ["process-flow", "state-transition", "evidence-gate", "causal-chain", "before-after", "layered-system", "aggregate-decompose", "focus-zoom", "threshold-landing", "converge-diffuse"]},
        "styleProfileId": {"enum": ["paper-editorial", "stop-motion-machine", "research-archive"]},
        "stages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["id", "spokenQuote", "action", "label"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
              "spokenQuote": {"type": "string", "minLength": 1},
              "action": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "imageAssetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,61}$"},
              "imageAssetLabel": {"type": "string", "minLength": 1, "maxLength": 120},
              "iconId": {"type": "string", "pattern": "^system\\.[a-z0-9-]+$"}
            },
            "additionalProperties": false
          }
        },
        "takeaway": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
