{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seanlab.local/schemas/narration-visual-storyboard.schema.json",
  "title": "Narration Visual Storyboard",
  "type": "object",
  "required": ["schemaVersion", "sections"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "sections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["mode", "status"],
        "properties": {
          "mode": {"enum": ["auto", "speaker", "speaker-only", "material", "information", "animation"]},
          "status": {"enum": ["suggested", "confirmed"]},
          "form": {
            "enum": [
              "two-way-contrast", "multi-dimension-comparison", "ordered-progression",
              "progressive-explanation", "cause-to-result", "conditional-outcomes",
              "number-focus", "ranking-or-distribution", "change-over-time", "dated-milestones",
              "category-map", "core-and-supports", "tradeoff-or-positioning",
              "source-backed-evidence", "text-emphasis", "plain-language-claim"
            ]
          },
          "materialDisplay": {"enum": ["full", "crop", "annotate"]},
          "materialKind": {"enum": ["screenshot", "screen-recording"]},
          "componentId": {
            "enum": [
              "distribution-bars", "scenario-branches", "market-cap-lines", "person-evidence-card",
              "factor-sequence", "ranked-metric-list", "binary-versus", "key-stat-summary",
              "media-comparison", "image-evidence-inset", "process-steps", "causal-chain",
              "quote-source-card", "historical-timeline", "decision-matrix", "model-classification-map",
              "core-positioning-node", "capability-surface-grid", "tradeoff-scale", "rough-annotation", "editorial-statement"
            ]
          },
          "materialId": {"type": "string", "minLength": 1},
          "animationIntent": {"$ref": "#/$defs/animationIntent"},
          "annotations": {
            "type": "array",
            "maxItems": 12,
            "items": {"$ref": "#/$defs/textAnnotation"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "textAnnotation": {
      "type": "object",
      "required": ["id", "exactSpokenQuote", "status", "effect"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
        "exactSpokenQuote": {"type": "string", "minLength": 2, "maxLength": 24, "pattern": "^[^\\r\\n]+$"},
        "quoteOccurrence": {"type": "integer", "minimum": 1},
        "status": {"enum": ["suggested", "confirmed"]},
        "effect": {"enum": ["highlight", "underline", "circle", "box", "crossed-off", "strike-through", "bracket"]}
      },
      "additionalProperties": false
    },
    "animationIntent": {
      "type": "object",
      "required": ["prototypeId", "styleProfileId", "stages", "takeaway"],
      "properties": {
        "prototypeId": {"enum": ["process-flow", "state-transition", "evidence-gate", "causal-chain", "before-after", "layered-system"]},
        "styleProfileId": {"const": "paper-editorial"},
        "stages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["id", "spokenQuote", "action", "label"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
              "spokenQuote": {"type": "string", "minLength": 1},
              "action": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "imageAssetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,61}$"},
              "imageAssetLabel": {"type": "string", "minLength": 1, "maxLength": 120},
              "iconId": {"type": "string", "pattern": "^system\\.[a-z0-9-]+$"}
            },
            "additionalProperties": false
          }
        },
        "takeaway": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
