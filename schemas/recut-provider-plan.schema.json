{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-remotion.local/schemas/recut-provider-plan.schema.json",
  "title": "Conservative Recut Provider Plan",
  "type": "object",
  "required": ["schemaVersion", "candidates"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0"},
    "candidates": {
      "type": "array",
      "maxItems": 48,
      "items": {
        "type": "object",
        "required": ["kind", "startWord", "endWord", "confidence", "reason"],
        "properties": {
          "kind": {"type": "string", "enum": ["filler", "false-start", "duplicate-retake"]},
          "startWord": {"type": "integer", "minimum": 0},
          "endWord": {"type": "integer", "minimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string", "minLength": 1, "maxLength": 300}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
