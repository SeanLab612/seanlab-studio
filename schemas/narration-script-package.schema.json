{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-remotion.local/schemas/narration-script-package.schema.json",
  "title": "Narration Script Package",
  "type": "object",
  "required": ["schemaVersion", "title", "opening", "overview", "sections", "conclusion", "fullScript", "shootingGuide"],
  "properties": {
    "schemaVersion": {"type": "string", "enum": ["1.0"]},
    "title": {"type": "string", "minLength": 1},
    "opening": {"type": "string", "minLength": 1},
    "overview": {"type": "string", "minLength": 1},
    "sections": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "title", "narration", "visualIntent", "visualOpportunities", "materialIds", "recordingInstruction"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
          "title": {"type": "string", "minLength": 1},
          "narration": {"type": "string", "minLength": 1},
          "visualIntent": {"type": "string", "enum": ["speaker", "screen-recording", "screenshot", "semantic-visual"]},
          "visualOpportunities": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["form", "evidenceText"],
              "properties": {
                "form": {
                  "type": "string",
                  "enum": [
                    "two-way-contrast",
                    "multi-dimension-comparison",
                    "ordered-progression",
                    "progressive-explanation",
                    "cause-to-result",
                    "conditional-outcomes",
                    "number-focus",
                    "ranking-or-distribution",
                    "change-over-time",
                    "dated-milestones",
                    "category-map",
                    "core-and-supports",
                    "tradeoff-or-positioning",
                    "source-backed-evidence",
                    "text-emphasis"
                  ]
                },
                "evidenceText": {"type": "string", "minLength": 1, "maxLength": 160}
              },
              "additionalProperties": false
            }
          },
          "materialIds": {"type": "array", "maxItems": 1, "items": {"type": "string"}},
          "recordingInstruction": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "conclusion": {"type": "string", "minLength": 1},
    "fullScript": {"type": "string", "minLength": 1},
    "shootingGuide": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
