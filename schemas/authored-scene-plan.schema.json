{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-remotion.local/schemas/authored-scene-plan.schema.json",
  "title": "Authored Screen Scene Plan",
  "type": "object",
  "required": ["schemaVersion", "scenes"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "assetId", "startAnchor", "endAnchor", "required", "speakerPip"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
          "type": {"enum": ["screen-evidence", "result-showcase"]},
          "assetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
          "startAnchor": {"$ref": "#/$defs/anchor"},
          "endAnchor": {"$ref": "#/$defs/anchor"},
          "required": {"type": "boolean"},
          "executionPolicy": {"enum": ["locked", "reference"]},
          "visualBeatId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
          "speakerPip": {
            "type": "object",
            "required": ["shape", "preferredPosition"],
            "properties": {
              "shape": {"enum": ["circle", "rounded-rectangle"]},
              "preferredPosition": {"enum": ["top-left", "top-right", "bottom-left", "bottom-right"]},
              "size": {"type": "number", "minimum": 240, "maximum": 520},
              "objectPosition": {"type": "string", "minLength": 3}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 4},
        "occurrence": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
